@inherits LayoutComponentBase

<div class="emr-shell">
    <header class="emr-header">
        <a href="/" class="brand">
            <img src="/images/logo.png" alt="TTYT KV Liên Chiểu" class="brand-logo" onerror="this.style.display='none'" />
            <span class="brand-text">
                <span class="brand-line1">TTYT KV Liên Chiểu</span>
                <span class="brand-line2">EMR & Ký số</span>
            </span>
        </a>
        <nav class="emr-nav">
            <AuthorizeView>
                <Authorized>
                    <a href="/dashboard">Dashboard</a>
                    <a href="/hoso">Hồ sơ bệnh án</a>
                    <a href="/hoso/moi">+ Tạo mới</a>
                    <AuthorizeView Roles="ADMIN">
                        <Authorized Context="adm">
                            <a href="/admin/users">Người dùng</a>
                            <a href="/admin/audit">Audit</a>
                        </Authorized>
                    </AuthorizeView>
                    <a href="/regulations">Pháp lý</a>
                </Authorized>
            </AuthorizeView>
        </nav>
        <div class="emr-user">
            <AuthorizeView>
                <Authorized>
                    <a href="/profile" class="u-name" title="Tài khoản của tôi">@context.User.FindFirst("hoTen")?.Value</a>
                    <span class="u-khoa">@context.User.FindFirst("khoaTen")?.Value</span>
                    <form action="/auth/logout" method="post" style="display:inline">
                        <button type="submit" class="btn-link">Đăng xuất</button>
                    </form>
                </Authorized>
            </AuthorizeView>
        </div>
    </header>
    <main class="emr-main">
        @Body
    </main>
</div>

<div id="blazor-error-ui">
    Đã xảy ra lỗi không mong muốn.
    <a href="" class="reload">Tải lại</a>
    <a class="dismiss">🗙</a>
</div>
