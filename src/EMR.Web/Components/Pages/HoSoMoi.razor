@page "/hoso/moi"
@attribute [Authorize]
@rendermode InteractiveServer
@inject HoSoService Svc
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState

<PageTitle>Tạo hồ sơ mới</PageTitle>

<section class="page-head">
    <h1>Tạo hồ sơ bệnh án</h1>
</section>

<div class="card">
    <h3>Bước 1: Tra cứu bệnh nhân từ HIS</h3>
    <div class="form-row">
        <input @bind="keyword" @bind:event="oninput" placeholder="Mã BN, tên hoặc CCCD..." class="input-search" />
        <button class="btn" @onclick="Search">Tìm</button>
    </div>

    @if (results is not null)
    {
        @if (results.Count == 0)
        {
            <p class="muted">Không tìm thấy bệnh nhân nào.</p>
        }
        else
        {
            <table class="data-table">
                <thead><tr><th>Mã BN</th><th>Họ tên</th><th>Ngày sinh</th><th>CCCD</th><th>Địa chỉ</th><th></th></tr></thead>
                <tbody>
                @foreach (var b in results)
                {
                    <tr class="@(selected?.Ma == b.Ma ? "row-selected" : "")">
                        <td>@b.Ma</td>
                        <td><strong>@b.HoTen</strong></td>
                        <td>@b.NgaySinh?.ToString("dd/MM/yyyy")</td>
                        <td>@b.CCCD</td>
                        <td>@b.DiaChi</td>
                        <td><button class="btn btn-sm" @onclick="() => Select(b)">Chọn</button></td>
                    </tr>
                }
                </tbody>
            </table>
        }
    }
</div>

@if (selected is not null)
{
    <div class="card" style="margin-top:1rem">
        <h3>Bước 2: Xác nhận tạo hồ sơ</h3>
        <p>
            Bệnh nhân: <strong>@selected.HoTen</strong>
            (mã <code>@selected.Ma</code>, sinh @selected.NgaySinh?.ToString("dd/MM/yyyy"))
        </p>
        @if (!string.IsNullOrEmpty(error))
        {
            <div class="alert alert-error">@error</div>
        }
        <button class="btn btn-primary" disabled="@creating" @onclick="Create">
            @(creating ? "Đang tạo..." : "Tạo hồ sơ")
        </button>
        <a href="/hoso" class="btn btn-link">Hủy</a>
    </div>
}

@code {
    private string keyword = "";
    private List<BenhNhan_Wrapper>? results;
    private BenhNhan_Wrapper? selected;
    private bool creating;
    private string? error;

    private async Task Search()
    {
        var data = await Svc.SearchHisAsync(keyword);
        results = data.Select(b => new BenhNhan_Wrapper(b.Ma, b.HoTen, b.NgaySinh, b.CCCD, b.DiaChi)).ToList();
        selected = null;
    }

    private void Select(BenhNhan_Wrapper b) { selected = b; error = null; }

    private async Task Create()
    {
        if (selected is null) return;
        creating = true; error = null;
        try
        {
            var auth = await AuthState.GetAuthenticationStateAsync();
            var uid = Guid.Parse(auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)!.Value);
            var (id, ma) = await Svc.TaoHoSoAsync(selected.Ma, null, uid);
            Nav.NavigateTo($"/hoso/{id}");
        }
        catch (Exception ex)
        {
            error = ex.Message;
            creating = false;
        }
    }

    public record BenhNhan_Wrapper(string Ma, string HoTen, DateTime? NgaySinh, string? CCCD, string? DiaChi);
}
