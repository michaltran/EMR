@page "/admin/users"
@attribute [Authorize(Roles = "ADMIN")]
@rendermode InteractiveServer
@inject UserService UserSvc
@inject NavigationManager Nav

<PageTitle>Quản lý người dùng</PageTitle>

<section class="page-head">
    <h1>Quản lý người dùng</h1>
    <div class="actions">
        <input @bind="keyword" @bind:event="oninput" placeholder="Tìm theo username/họ tên/CCCD..." class="input-search" />
        <a href="/admin/users/new" class="btn btn-primary">+ Tạo user</a>
    </div>
</section>

@if (items is null) { <p>Đang tải…</p> }
else if (Filtered().Count == 0)
{
    <div class="empty-state">Không có user nào khớp.</div>
}
else
{
    <table class="data-table">
        <thead>
            <tr>
                <th>Username</th><th>Họ tên</th><th>CCCD</th><th>Khoa</th><th>Vai trò</th><th>TT</th><th>Ngày tạo</th><th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var u in Filtered())
        {
            <tr>
                <td><strong>@u.TenDangNhap</strong></td>
                <td>@u.HoTen</td>
                <td><code>@u.CCCD</code></td>
                <td>@u.KhoaTen</td>
                <td>
                    @foreach (var v in u.VaiTros)
                    {
                        <span class="role-pill">@v</span>
                    }
                </td>
                <td>
                    @if (u.TrangThai == 1) { <span class="status status-daky">Hoạt động</span> }
                    else { <span class="status status-huy">Khóa</span> }
                </td>
                <td>@u.NgayTao.ToLocalTime():dd/MM/yyyy</td>
                <td><a href="@($"/admin/users/{u.Id}")" class="btn btn-sm">Sửa</a></td>
            </tr>
        }
        </tbody>
    </table>
}

@code {
    private List<UserListItem>? items;
    private string keyword = "";

    protected override async Task OnInitializedAsync() => items = await UserSvc.ListAsync(null);

    private List<UserListItem> Filtered()
    {
        if (items is null) return [];
        if (string.IsNullOrWhiteSpace(keyword)) return items;
        var k = keyword.Trim().ToLowerInvariant();
        return items.Where(u => u.TenDangNhap.ToLower().Contains(k) || u.HoTen.ToLower().Contains(k) || (u.CCCD?.Contains(k) ?? false)).ToList();
    }
}
