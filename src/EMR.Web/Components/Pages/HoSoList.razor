@page "/hoso"
@attribute [Authorize]
@rendermode InteractiveServer
@inject HoSoService Svc
@inject NavigationManager Nav

<PageTitle>Hồ sơ bệnh án</PageTitle>

<section class="page-head">
    <h1>Hồ sơ bệnh án</h1>
    <a href="/hoso/moi" class="btn btn-primary">+ Tạo hồ sơ mới</a>
</section>

<div class="card">
    <div class="form-row">
        <input @bind="keyword" @bind:event="oninput" placeholder="Mã HS, tên BN, mã BN..." class="input-search" />
        <select @bind="filterKhoa">
            <option value="">— Mọi khoa —</option>
            @foreach (var k in khoas)
            {
                <option value="@k.Id">@k.Ten</option>
            }
        </select>
        <select @bind="filterTT">
            <option value="">— Mọi trạng thái —</option>
            <option value="0">Nháp</option>
            <option value="1">Chờ ký</option>
            <option value="2">BS đã ký</option>
            <option value="3">TK đã ký</option>
            <option value="4">LĐ đã ký</option>
            <option value="9">Hoàn tất</option>
            <option value="99">Đã hủy</option>
        </select>
        <button class="btn btn-primary" @onclick="Reload">Lọc</button>
        <button class="btn" @onclick="Reset">Xóa lọc</button>
        <span class="muted small" style="margin-left:auto">@(items?.Count ?? 0) HSBA</span>
    </div>
</div>

@if (items is null)
{
    <p style="margin-top:1rem">Đang tải…</p>
}
else if (items.Count == 0)
{
    <div class="empty-state">
        <p>Không có hồ sơ nào khớp tiêu chí.</p>
        <a href="/hoso/moi" class="btn btn-primary">+ Tạo hồ sơ</a>
    </div>
}
else
{
    <table class="data-table" style="margin-top:1rem">
        <thead>
        <tr>
            <th>Mã HS</th><th>Bệnh nhân</th><th>Mã BN</th><th>Khoa</th>
            <th>Trạng thái</th><th>Tài liệu</th><th>Ngày tạo</th><th></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var h in items)
        {
            <tr>
                <td><strong>@h.MaHoSo</strong></td>
                <td>@h.HoTenBenhNhan</td>
                <td><code>@h.MaBenhNhanHIS</code></td>
                <td>@h.KhoaTen</td>
                <td><span class="status status-@h.TrangThai.ToString().ToLower()">@TrangThaiText(h.TrangThai)</span></td>
                <td>@h.SoTaiLieu</td>
                <td>@h.NgayTao.ToLocalTime():dd/MM/yyyy HH:mm</td>
                <td><a href="@($"/hoso/{h.Id}")" class="btn btn-sm">Mở</a></td>
            </tr>
        }
        </tbody>
    </table>
}

@code {
    private List<HoSoListVM>? items;
    private List<Khoa> khoas = [];
    private string keyword = "";
    private string filterKhoa = "";
    private string filterTT = "";

    protected override async Task OnInitializedAsync()
    {
        khoas = await Svc.GetKhoasAsync();
        await Reload();
    }

    private async Task Reload()
    {
        Guid? khoaId = Guid.TryParse(filterKhoa, out var k) ? k : null;
        TrangThaiHoSo? tt = byte.TryParse(filterTT, out var b) ? (TrangThaiHoSo)b : null;
        items = await Svc.ListAsync(khoaId, keyword, tt);
    }

    private async Task Reset()
    {
        keyword = ""; filterKhoa = ""; filterTT = "";
        await Reload();
    }

    private static string TrangThaiText(TrangThaiHoSo t) => t switch
    {
        TrangThaiHoSo.Draft => "Nháp",
        TrangThaiHoSo.ChoKy => "Chờ ký",
        TrangThaiHoSo.DaKyBacSi => "BS đã ký",
        TrangThaiHoSo.DaKyTruongKhoa => "TK đã ký",
        TrangThaiHoSo.DaKyLanhDao => "LĐ đã ký",
        TrangThaiHoSo.HoanTat => "Hoàn tất",
        TrangThaiHoSo.Huy => "Đã hủy",
        _ => t.ToString()
    };
}
